# Copia este archivo a .env.local y pon tus valores. .env.local nunca va a git.

# La llave privada de la tienda (Ajustes › Desarrolladores en Ami).
# Usa una llave de prueba (ami_test_…) mientras desarrollas.
AMI_API_KEY=ami_test_reemplaza_esto

# La API de tiendas de Ami.
AMI_API_URL=https://api.amiagente.com/v1/storefront

# El secreto del webhook (Ajustes › Desarrolladores › Webhooks).
AMI_WEBHOOK_SECRET=whsec_reemplaza_esto

# La dirección pública de este sitio: Ami devuelve al cliente aquí después de pagar.
SITE_URL=http://localhost:3000
